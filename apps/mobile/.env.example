# Copy to `.env` and fill in. `.env` is gitignored — never commit keys.
# Restart the Metro bundler after creating or changing `.env`.
#
# Demo only: EXPO_PUBLIC_ values ship inside the app bundle. Fine for the
# hackathon build. Rotate this key right after the contest submission; a
# production build must call the model through your own server, never with
# a key embedded in the app.

# Base URL of the Meta Model API (no trailing slash). Locked 2026-10-29:
# the full host WITH /v1; the app appends /chat/completions itself.
EXPO_PUBLIC_META_MODEL_API_BASE_URL=https://api.meta.ai/v1

# API key for the Meta Model API.
EXPO_PUBLIC_META_MODEL_API_KEY=paste-key-here
