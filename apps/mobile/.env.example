# Copy to `.env` and fill in. `.env` is gitignored — never commit keys.
# Restart the Metro bundler after creating or changing `.env`.
#
# Demo only: the key ships inside the app bundle. Fine for the hackathon
# build; a production build must call the model through your own server.

# Base URL of the Meta Model API (no trailing slash).
EXPO_PUBLIC_META_MODEL_API_BASE_URL=https://your-meta-model-endpoint.example

# API key for the Meta Model API.
EXPO_PUBLIC_META_MODEL_API_KEY=paste-key-here
